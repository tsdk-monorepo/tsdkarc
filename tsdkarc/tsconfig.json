{
  "extends": "@tsconfig/recommended/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "target": "es2015",
    "lib": ["ES2015", "DOM", "ES2019.Object", "ES2022", "dom.iterable"],
    "esModuleInterop": true,
    "declaration": true,
    "outDir": "./lib",
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "strictNullChecks": true
  },
  "include": ["./src"],
  "exclude": ["node_modules"]
}
