{
  "extends": "@tsconfig/recommended/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "lib": ["ES2015", "DOM", "ES2019.Object", "ES2022"],
    "esModuleInterop": true,
    "declaration": true,
    "outDir": "./lib",
    "noImplicitAny": true
  },
  "include": ["./src", "@types/node"],
  "exclude": ["node_modules", "./src/x"]
}
