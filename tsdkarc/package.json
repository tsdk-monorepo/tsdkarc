{
  "name": "tsdkarc",
  "version": "2.0.0-alpha.0",
  "description": "An elegant module composable library and it's type-safe",
  "repository": "tsdk-monorepo/tsdkarc",
  "bugs": "https://github.com/tsdk-monorepo/tsdkarc/issues",
  "homepage": "https://arc.tsdk.dev",
  "main": "./lib/index.js",
  "module": "./esm/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "require": "./lib/index.js",
      "import": "./esm/index.js",
      "types": "./lib/index.d.ts"
    }
  },
  "scripts": {
    "build": "concurrently \"npm run build:cjs\"  \"npm run build:esm\"",
    "build:cjs": "rm -rf lib && tsc --project tsconfig.cjs.json && rm -rf lib/tests",
    "build:esm": "rm -rf esm && tsc --project tsconfig.esm.json && rm -rf esm/tests",
    "checktype": "tsc --noEmit --project tsconfig.tests.json",
    "checktype2": "tsc --noEmit --project tsconfig.checktype2.json",
    "test": "npm run checktype && vitest --run --testTimeout=120000 --hookTimeout=60000 ./tests",
    "customtest": "vitest --run --testTimeout=120000 --hookTimeout=60000"
  },
  "files": [
    "lib/*",
    "esm/*",
    "assets",
    "README.md"
  ],
  "keywords": [
    "typesafe",
    "module composable",
    "functional composition",
    "no dependency injection",
    "tsdkarc",
    "tsdk"
  ],
  "devDependencies": {
    "typescript": "^6.0.3",
    "@tsconfig/recommended": "^1.0.10",
    "vitest": "^3.2.4",
    "concurrently": "^9.2.1",
    "@types/node": "^25.5.0",
    "xior": "^0.8.3",
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "ws": "^8.20.0",
    "@types/ws": "^8.18.1",
    "multer": "^2.1.1"
  },
  "license": "MIT"
}
